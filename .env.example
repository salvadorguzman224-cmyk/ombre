# Copy this file to .env.local and fill in the two values from your Supabase project:
# Supabase dashboard → Project Settings → API Keys (and Data API for the URL).
# .env.local is ignored by git, so your keys never get uploaded.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
